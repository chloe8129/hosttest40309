# ==============================================================================
# BERMUDA PORTAL - BOT-HOSTING.NET CLOUD GATEWAY ENVIRONMENT TEMPLATE
# Platform: Bot-Hosting.net (Hetzner Finland fi-hel1 & Germany de-fra1) + Cloudflare
# Calibrated for 256 MB RAM Free Tier & 1 GB / 2 GB Starter Tiers
# ==============================================================================

# [Recommended for Edge Tuning & Multi-Port] Cloudflare API Token (Zone/DNS/Ruleset Edit)
CLOUDFLARE_API_TOKEN=

# [Optional] Explicit Cloudflare Zone ID (Auto-discovered if left empty)
CLOUDFLARE_ZONE_ID=

# [Recommended for Auto-Provisioning] Bot-Hosting API Key (starts with bhk_...)
# Create at: https://bot-hosting.net/panel (Account / Developer Settings -> API Keys)
BOTHOSTING_API_KEY=

# [Optional] Explicit Bot-Hosting Deployment ID (e.g. dep_... - Auto-discovered if empty)
BOTHOSTING_DEPLOYMENT_ID=

# [Optional] Custom Domain routed through Cloudflare Edge (e.g. portal.yourdomain.dpdns.org)
CUSTOM_DOMAIN=

# [Optional] Free Activated Subdomain from Domains Tab (e.g. mybot.apps.bot-hosting.cloud)
# Auto-discovered via API or first incoming HTTP request if left empty
BOTHOSTING_SUBDOMAIN=

# [Optional] Explicit Node Hostname or IP (e.g. fi3.bot-hosting.net or 65.108.103.151)
# Auto-discovered via BOTHOSTING_API_KEY if left empty
BOTHOSTING_NODE_HOST=

# [Optional] Master Secret Seed for Deterministic Key Derivation (Auto-generated & persisted if empty)
BERMUDA_MASTER_KEY=

# [Optional] Deployment Region (fi-hel1, de-fra1, europe-west4, us-east4, us-west, asia-southeast1)
BERMUDA_REGION=fi-hel1
